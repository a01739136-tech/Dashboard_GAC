   "source": [
    "%%writefile app_leads.py\n",
    "#creamos el archivo de la APP en el interprete prinicpal de python\n",
    "#NUNCA PONER COMENTARIOS EN EL CODIGO DE LA APP, YA QUE STREAMLIT NO LOS RECONOCE\n",
    "############################################################\n",
    "#Importamos librerias\n",
    "import streamlit as st\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import plotly.express as px\n",
    "import plotly.graph_objects as go\n",
    "from plotly.subplots import make_subplots\n",
    "######################################################\n",
    "#Definimos la instancia\n",
    "@st.cache_resource\n",
    "######################################################\n",
    "########################################################\n",
    "#Creamos la función de carga de datos\n",
    "def load_data():\n",
    "    #Lectura del archivo csv\n",
    "    df = pd.read_csv(\"base leads.csv\")\n",
    "    data = df.copy()\n",
    "    #Quitamos espacios en los nombres de las columnas\n",
    "    data.columns = data.columns.str.strip()\n",
    "    #Año y Mes como enteros, y creamos la columna de fecha\n",
    "    data['Año'] = data['Año'].astype(int)\n",
    "    data['Mes'] = data['Mes'].astype(int)\n",
    "    data['Fecha'] = pd.to_datetime(dict(year=data['Año'], month=data['Mes'], day=1))\n",
    "    #Quitamos los meses sin leads\n",
    "    data = data[data['Total'] > 0].reset_index(drop=True)\n",
    "    #Conversión sobre efectivos y sobre el total\n",
    "    data['Conv_Efectivos'] = data['Ventas'] / data['Efectivos'] * 100\n",
    "    data['Conv_Total'] = data['Ventas'] / data['Total'] * 100\n",
    "    #Categorías de calidad del lead y su suma\n",
    "    categorias = ['Efectivos', 'Ilocalizable', 'No Contesta', 'D. Incorrectos', 'Duplicados']\n",
    "    data['Suma_Cat'] = data[categorias].sum(axis=1)\n",
    "    return data, categorias\n",
    "########################################################\n",
    "#Cargo los datos obtenidos de la función \"load_data\"\n",
    "data, categorias = load_data()\n",
    "nombres_meses = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic']\n",
    "########################################################\n",
    "#CREACIÓN DEL DASHBOARD\n",
    "#Generamos los encabezados para la barra lateral (sidebar)\n",
    "st.sidebar.title(\"LEADS\")\n",
    "#Widget 1: Selectbox con las páginas\n",
    "View = st.sidebar.selectbox(label=\"Tipo de Análisis\", options=[\"Ventas y Conversión\",\n",
    "                                                                \"Calidad del Lead\", \"Regresión Lineal\", \"Regresión Logística\"])\n",
    "#Widget 2: Filtro de años\n",
    "Lista_Años = sorted(data['Año'].unique())\n",
    "Años_sel = st.sidebar.multiselect(label=\"Años\", options=Lista_Años, default=Lista_Años)\n",
    "data_f = data[data['Año'].isin(Años_sel)]\n",
    "if data_f.empty:\n",
    "    st.warning(\"Selecciona al menos un año en la barra lateral\")\n",
    "    st.stop()\n",
    " \n",
    "# CONTENIDO DE LA VISTA 1\n",
    "if View == \"Ventas y Conversión\":\n",
    "    st.title(\"Ventas y Conversión\")\n",
    " \n",
    "    #Fila 0: indicadores principales\n",
    "    Kpi_1, Kpi_2, Kpi_3, Kpi_4 = st.columns(4)\n",
    "    Kpi_1.metric(\"Total leads\", f\"{data_f['Total'].sum():,.0f}\")\n",
    "    Kpi_2.metric(\"Efectivos\", f\"{data_f['Efectivos'].sum():,.0f}\")\n",
    "    Kpi_3.metric(\"Ventas\", f\"{data_f['Ventas'].sum():,.0f}\")\n",
    "    Kpi_4.metric(\"Conversión (% efectivos)\",\n",
    "                 f\"{data_f['Ventas'].sum() / data_f['Efectivos'].sum() * 100:.1f}%\")\n",
    " \n",
    "    # Fila 1\n",
    "    Contenedor_A, Contenedor_B = st.columns(2)\n",
    "    with Contenedor_A:\n",
    "        st.write(\"Ventas y conversión por mes\")\n",
    "        #GRAPH 1: BARRAS + LÍNEA CON DOBLE EJE\n",
    "        figure1 = make_subplots(specs=[[{\"secondary_y\": True}]])\n",
    "        figure1.add_trace(go.Bar(x=data_f['Fecha'], y=data_f['Ventas'], name='Ventas',\n",
    "                                 marker_color='royalblue'), secondary_y=False)\n",
    "        figure1.add_trace(go.Scatter(x=data_f['Fecha'], y=data_f['Conv_Efectivos'],\n",
    "                                     name='Conversión (%)', mode='lines+markers',\n",
    "                                     line=dict(color='orange')), secondary_y=True)\n",
    "        figure1.update_yaxes(title_text='Ventas', secondary_y=False)\n",
    "        figure1.update_yaxes(title_text='Conversión (% de efectivos)', secondary_y=True)\n",
    "        figure1.update_layout(height=400, legend=dict(orientation='h', y=-0.2))\n",
    "        st.plotly_chart(figure1)\n",
    " \n",
    "    with Contenedor_B:\n",
    "        st.write(\"Embudo de conversión\")\n",
    "        #GRAPH 2: EMBUDO\n",
    "        Tabla_embudo = pd.DataFrame({'etapa': ['Total leads', 'Efectivos', 'Ventas'],\n",
    "                                     'valor': [data_f['Total'].sum(), data_f['Efectivos'].sum(),\n",
    "                                               data_f['Ventas'].sum()]})\n",
    "        figure2 = px.funnel(Tabla_embudo, x='valor', y='etapa',\n",
    "                            color_discrete_sequence=['royalblue'])\n",
    "        figure2.update_traces(textinfo='value+percent initial')\n",
    "        figure2.update_layout(height=400)\n",
    "        st.plotly_chart(figure2)\n",
    " \n",
    "# CONTENIDO DE LA VISTA 2\n",
    "if View == \"Calidad del Lead\":\n",
    "    st.title(\"Calidad del Lead\")\n",
    " \n",
    "    # Fila 1\n",
    "    st.write(\"Calidad del lead (% por mes)\")\n",
    "    #GRAPH 3: BARRAS APILADAS\n",
    "    calidad = data_f[categorias].div(data_f['Suma_Cat'], axis=0) * 100\n",
    "    calidad['Mes'] = data_f['Fecha'].dt.strftime('%b %y')\n",
    "    Tabla_calidad = calidad.melt(id_vars='Mes', var_name='categoria', value_name='porcentaje')\n",
    "    figure3 = px.bar(Tabla_calidad, x='Mes', y='porcentaje', color='categoria',\n",
    "                     color_discrete_sequence=['green', 'gray', 'orange', 'red', 'purple'])\n",
    "    figure3.update_layout(height=450, barmode='stack', yaxis_title='% del total',\n",
    "                          legend=dict(orientation='h', y=-0.25))\n",
    "    st.plotly_chart(figure3)\n",
    " \n",
    "    # Fila 2\n",
    "    st.write(\"Conversión (%) por año y mes\")\n",
    "    #GRAPH 4: HEATMAP\n",
    "    pivot_conv = data_f.pivot(index='Año', columns='Mes', values='Conv_Efectivos')\n",
    "    pivot_conv = pivot_conv.reindex(columns=range(1, 13))\n",
    "    pivot_conv.columns = nombres_meses\n",
    "    figure4 = px.imshow(pivot_conv, text_auto='.1f', color_continuous_scale='Blues',\n",
    "                        aspect='auto')\n",
    "    figure4.update_yaxes(type='category')\n",
    "    figure4.update_layout(height=350)\n",
    "    st.plotly_chart(figure4)\n",
    "\n",
    "    ###Codigo de regresion lineal para predicción de ventas\n",
    "     # CONTENIDO DE LA VISTA 2\n",
    "if View == \"Regresión Lineal\":\n",
    "    from sklearn.linear_model import LinearRegression\n",
    "    st.title(\"📈 Regresión Lineal\")\n",
    "\n",
    "    excluir = ['Año', 'Mes', 'Conv_Efectivos', 'Conv_Total', 'Suma_Cat']\n",
    "    numeric_df = data_f.select_dtypes('number').drop(columns=excluir, errors='ignore')\n",
    "    Lista_num = list(numeric_df.columns)\n",
    "\n",
    "    Variable_y = st.sidebar.selectbox(\"Variable objetivo (Y)\", Lista_num,\n",
    "                                      index=Lista_num.index(\"Ventas\"))\n",
    "    opciones_x = [c for c in Lista_num if c != Variable_y]\n",
    "    Variable_x = st.sidebar.selectbox(\"Variable independiente simple (X)\", opciones_x,\n",
    "                                      index=opciones_x.index(\"Efectivos\"))\n",
    "    Variables_x = st.sidebar.multiselect(\"Variables independientes múltiple (X)\", opciones_x,\n",
    "                                         default=[c for c in [\"Efectivos\", \"Total\"] if c in opciones_x])\n",
    "    if not Variables_x:\n",
    "        st.warning(\"Selecciona al menos una variable para el modelo múltiple\")\n",
    "        st.stop()\n",
    "\n",
    "    Contenedor_A, Contenedor_B = st.columns(2)\n",
    "\n",
    "    with Contenedor_A:\n",
    "        st.subheader(\"Regresión lineal simple\")\n",
    "        model = LinearRegression().fit(numeric_df[[Variable_x]], numeric_df[Variable_y])\n",
    "        y_pred = model.predict(numeric_df[[Variable_x]])\n",
    "        r2 = model.score(numeric_df[[Variable_x]], numeric_df[Variable_y])\n",
    "        r = np.corrcoef(numeric_df[Variable_x], numeric_df[Variable_y])[0, 1]\n",
    "        m1, m2 = st.columns(2)\n",
    "        m1.metric(\"r (correlación)\", f\"{r:.3f}\")\n",
    "        m2.metric(\"R²\", f\"{r2:.3f}\")\n",
