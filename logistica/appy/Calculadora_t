   "source": [
    "%%writefile app.py \n",
    "\n",
    "import streamlit as st\n",
    "import pandas as pd\n",
    "\n",
    "st.set_page_config(page_title=\"Calculadora de Ranking\", page_icon=\"🏆\")\n",
    "\n",
    "st.title(\"🏆 Calculadora de Ranking\")\n",
    "\n",
    "st.write(\n",
    "    \"Ingresa tus ventas para conocer la posición que alcanzarías \"\n",
    "    \"en el ranking actual.\"\n",
    ")\n",
    "\n",
    "# Cargar la base de datos\n",
    "df = pd.read_csv(\n",
    "    \"ventas_a_anual_sin_outliers.csv\",\n",
    "    encoding=\"utf-8-sig\"\n",
    ")\n",
    "\n",
    "df.columns = df.columns.str.strip()\n",
    "\n",
    "# Seleccionar el periodo\n",
    "periodo = st.selectbox(\n",
    "    \"¿Qué periodo quieres evaluar?\",\n",
    "    [\"Acum\", \"Acum 2024\", \"Acum 2025\", \"Acum 2026\"]\n",
    ")\n",
    "\n",
    "if periodo not in df.columns:\n",
    "    st.error(f\"No se encontró la columna {periodo} en el archivo.\")\n",
    "    st.stop()\n",
    "\n",
    "# Limpiar los datos\n",
    "df[periodo] = pd.to_numeric(df[periodo], errors=\"coerce\")\n",
    "\n",
    "datos = df.dropna(subset=[periodo]).copy()\n",
    "\n",
    "# Ingresar las ventas\n",
    "st.subheader(\"Ingresa tus ventas\")\n",
    "\n",
    "ventas = st.number_input(\n",
    "    \"¿Cuántas ventas esperas tener?\",\n",
    "    min_value=0.0,\n",
    "    value=50.0,\n",
    "    step=1.0\n",
    ")\n",
    "\n",
    "# Calcular el ranking\n",
    "if st.button(\"Calcular mi ranking\", type=\"primary\"):\n",
    "\n",
    "    # Contar cuántos vendedores tienen más ventas\n",
    "    vendedores_superiores = (datos[periodo] > ventas).sum()\n",
    "\n",
    "    # Contar vendedores empatados\n",
    "    vendedores_empatados = (datos[periodo] == ventas).sum()\n",
    "\n",
    "    ranking = vendedores_superiores + 1\n",
    "\n",
    "    st.divider()\n",
    "    st.subheader(\"Tu resultado\")\n",
    "\n",
    "    st.metric(\"Ventas ingresadas\", f\"{ventas:,.0f}\")\n",
    "\n",
    "    st.metric(\"Posición estimada\", f\"#{ranking}\")\n",
    "\n",
    "    if ranking == 1:\n",
    "        st.success(\"¡Con esas ventas estarías en el primer lugar!\")\n",
    "    else:\n",
    "        st.info(\n",
    "            f\"Hay {vendedores_superiores} vendedores con más ventas \"\n",
    "            \"que las que ingresaste.\"\n",
    "        )\n",
    "\n",
    "    if vendedores_empatados > 0:\n",
    "        st.warning(\n",
    "            f\"Actualmente hay {vendedores_empatados} vendedor(es) \"\n",
    "            \"con exactamente ese nivel de ventas. \"\n",
    "            \"Tu posición podría depender de cómo se resuelvan los empates.\"\n",
    "        )\n",
    "\n",
    "    st.caption(\n",
    "        \"El resultado compara tus ventas ingresadas con las ventas \"\n",
    "        \"registradas en la base de datos del periodo seleccionado. \"\n",
    "        \"Es una comparación, no una predicción de ventas futuras.\"\n",
    "    )"
