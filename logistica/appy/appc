# ================= FUNCIONES PARA REGRESIÓN LOGÍSTICA =================
METODOS = ["Sin ajuste", "Reponderación de clases", "Oversampling"]
 
 
def sigmoide(z):
    return 1 / (1 + np.exp(-np.clip(z, -30, 30)))
 
 
def ajustar_logit(X, y, pesos=None, l2=1.0, iters=100):
    """Regresión logística por Newton-Raphson (IRLS) con pesos por observación y penalización L2 ligera."""
    A = np.column_stack([np.ones(len(X)), X])
    w = np.ones(len(y)) if pesos is None else pesos
    b = np.zeros(A.shape[1])
    pen = np.eye(A.shape[1]) * l2
    pen[0, 0] = 0  # el intercepto no se penaliza
    for _ in range(iters):
        p = sigmoide(A @ b)
        grad = A.T @ (w * (y - p)) - pen @ b
        H = (A * (w * p * (1 - p))[:, None]).T @ A + pen + 1e-8 * np.eye(A.shape[1])
        paso = np.linalg.solve(H, grad)
        b = b + paso
        if np.abs(paso).max() < 1e-8:
            break
    return b
 
 
def partir_estratificado(y, test, seed):
    """Separa entrenamiento/prueba conservando la proporción de cada clase."""
    rng = np.random.default_rng(seed)
    tr, te = [], []
    for clase in (0, 1):
        idx = rng.permutation(np.where(y == clase)[0])
        n_te = min(max(1, int(round(test * len(idx)))), len(idx) - 1)
        te += list(idx[:n_te])
        tr += list(idx[n_te:])
    return np.array(tr), np.array(te)
 
 
def sobremuestrear(X, y, seed):
    """Oversampling aleatorio: duplica casos de la clase minoritaria hasta igualar a la mayoritaria."""
    rng = np.random.default_rng(seed)
    n1, n0 = int((y == 1).sum()), int((y == 0).sum())
    minoria = 1 if n1 < n0 else 0
    idx_min = np.where(y == minoria)[0]
    extra = rng.choice(idx_min, abs(n0 - n1), replace=True)
    idx = np.concatenate([np.arange(len(y)), extra])
    return X[idx], y[idx]
 
 
def entrenar(Xtr, ytr, metodo, seed, l2):
    """Estandariza con datos de entrenamiento, aplica el método de balanceo y ajusta el modelo."""
    mu = Xtr.mean(axis=0)
    sd = Xtr.std(axis=0)
    sd[sd == 0] = 1.0
    Xs = (Xtr - mu) / sd
    pesos = None
    if metodo == "Reponderación de clases":
        n = len(ytr)
        pesos = np.where(ytr == 1, n / (2 * (ytr == 1).sum()), n / (2 * (ytr == 0).sum()))
    elif metodo == "Oversampling":
        Xs, ytr = sobremuestrear(Xs, ytr, seed)
    return ajustar_logit(Xs, ytr, pesos, l2), mu, sd
 
 
def proba(modelo, X):
    b, mu, sd = modelo
    return sigmoide(b[0] + ((X - mu) / sd) @ b[1:])
 
 
def auc_roc(y, p):
    r = pd.Series(p).rank().to_numpy()
    n1, n0 = int((y == 1).sum()), int((y == 0).sum())
    return (r[y == 1].sum() - n1 * (n1 + 1) / 2) / (n1 * n0) if n1 and n0 else np.nan
 
 
def curva_roc(y, p):
    o = np.argsort(-p)
    ys = y[o]
    tpr = np.concatenate([[0], np.cumsum(ys) / max(ys.sum(), 1)])
    fpr = np.concatenate([[0], np.cumsum(1 - ys) / max((1 - ys).sum(), 1)])
    return fpr, tpr
 
 
def metricas(y, p, umbral):
    pred = (p >= umbral).astype(int)
    tp = int(((pred == 1) & (y == 1)).sum())
    tn = int(((pred == 0) & (y == 0)).sum())
    fp = int(((pred == 1) & (y == 0)).sum())
    fn = int(((pred == 0) & (y == 1)).sum())
    div = lambda a, b: a / b if b else 0.0
    prec, sens = div(tp, tp + fp), div(tp, tp + fn)
    return {"tp": tp, "tn": tn, "fp": fp, "fn": fn,
            "Exactitud": div(tp + tn, len(y)), "Precisión": prec, "Sensibilidad": sens,
            "Especificidad": div(tn, tn + fp), "F1": div(2 * prec * sens, prec + sens), "AUC": auc_roc(y, p)}
 
 
