    y_serie, col_excluir = objetivos[nombre_y]
    y_all = y_serie.astype(int).to_numpy()
 
    candidatas = [c for c in ["Hora", "Día de la semana (0=Lun)", "Producto", "Origen", "Asesor",
                              "Seguimiento", "Cita efetiva", "PDM", "SDC", "Estatus"] if c != col_excluir]
    X_vars = cB.multiselect("📌 Variables independientes (X)", candidatas,
                            default=[c for c in ["Hora", "Día de la semana (0=Lun)", "Producto", "Origen", "Seguimiento"] if c in candidatas])
    if not X_vars:
        st.info("Selecciona al menos una variable independiente.")
        st.stop()
 
    n1, n0 = int(y_all.sum()), int(len(y_all) - y_all.sum())
    if min(n1, n0) < 4:
        st.warning(f"Con los filtros actuales solo hay {min(n1, n0)} casos en la clase minoritaria; se necesitan al menos 4 para entrenar y evaluar.")
        st.stop()
 
    # ---- 2. Parámetros ----
    p1, p2, p3, p4 = st.columns(4)
    metodo = p1.selectbox("⚖️ Ajuste de desbalance", METODOS, index=1)
    umbral = p2.slider("Umbral de clasificación", 0.05, 0.95, 0.50, 0.05)
    test = p3.slider("% datos de prueba", 10, 50, 25, 5) / 100
    semilla = p4.number_input("Semilla aleatoria", 0, 9999, 42)
    l2 = 1.0
 
    categoricas = [c for c in X_vars if c in ["Producto", "Origen", "Asesor", "Seguimiento", "Cita efetiva", "PDM", "SDC", "Estatus"]]
    X_raw = d[X_vars].reset_index(drop=True)
    X_cod = codificar(X_raw, categoricas)
    columnas = list(X_cod.columns)
    X_all = X_cod.to_numpy(float)
 
    idx_tr, idx_te = partir_estratificado(y_all, test, int(semilla))
    Xtr, ytr, Xte, yte = X_all[idx_tr], y_all[idx_tr], X_all[idx_te], y_all[idx_te]
 
    modelo = entrenar(Xtr, ytr, metodo, int(semilla), l2)
    p_te = proba(modelo, Xte)
    m = metricas(yte, p_te, umbral)
 
    # ---- 3. KPIs ----
    st.markdown(f"**Datos:** {len(y_all)} leads · Clase 1 («Sí»): {n1} ({100 * n1 / len(y_all):.1f}%) · Clase 0 («No»): {n0} · "
                f"Entrenamiento: {len(ytr)} · Prueba: {len(yte)} ({int(yte.sum())} positivos)")
    k = st.columns(6)
    k[0].metric("Exactitud", f"{m['Exactitud']:.2%}")
    k[1].metric("Precisión", f"{m['Precisión']:.2%}")
    k[2].metric("Sensibilidad", f"{m['Sensibilidad']:.2%}")
    k[3].metric("Especificidad", f"{m['Especificidad']:.2%}")
    k[4].metric("F1", f"{m['F1']:.2f}")
    k[5].metric("AUC", f"{m['AUC']:.2f}")
    if n1 / len(y_all) < 0.2 or n1 / len(y_all) > 0.8:
        st.info("**Clases desbalanceadas:** la exactitud puede ser engañosa (un modelo que siempre diga «No» ya tendría exactitud alta). "
                "Fíjate sobre todo en **sensibilidad** y **precisión**, y compara los tres métodos en la tabla de abajo.")
 
    # ---- 4. Matriz de confusión y ROC ----
    g1, g2 = st.columns(2)
    with g1:
        st.write("Matriz de confusión (conjunto de prueba)")
        cm = pd.DataFrame([[m["tn"], m["fp"]], [m["fn"], m["tp"]]],
                          index=["Real: No", "Real: Sí"], columns=["Predicho: No", "Predicho: Sí"])
        fig_cm = px.imshow(cm, text_auto=True, color_continuous_scale="Blues", aspect="auto")
        fig_cm.update_layout(height=380, margin=dict(t=30, b=40, l=60, r=20), coloraxis_showscale=False)
        st.plotly_chart(fig_cm, use_container_width=True)
    with g2:
        st.write("Curva ROC (conjunto de prueba)")
        fpr, tpr = curva_roc(yte, p_te)
        fig_roc = go.Figure()
        fig_roc.add_trace(go.Scatter(x=fpr, y=tpr, mode="lines", name=f"Modelo (AUC={m['AUC']:.2f})", line=dict(color="#EF553B", width=3)))
        fig_roc.add_trace(go.Scatter(x=[0, 1], y=[0, 1], mode="lines", name="Azar", line=dict(dash="dash", color="gray")))
        fig_roc.update_layout(xaxis_title="1 − Especificidad (FPR)", yaxis_title="Sensibilidad (TPR)")
        ajustar(fig_roc, 380)
        st.plotly_chart(fig_roc, use_container_width=True)
 
    # ---- 5. Comparación de métodos de balanceo ----
    st.subheader("⚖️ Comparación: sin ajuste vs. reponderación vs. oversampling")
    filas = []
    for met in METODOS:
        mod = entrenar(Xtr, ytr, met, int(semilla), l2)
        mm = metricas(yte, proba(mod, Xte), umbral)
        filas.append({"Método": met, "Exactitud": mm["Exactitud"], "Precisión": mm["Precisión"], "Sensibilidad": mm["Sensibilidad"],
                      "Especificidad": mm["Especificidad"], "F1": mm["F1"], "AUC": mm["AUC"],
                      "VP": mm["tp"], "VN": mm["tn"], "FP": mm["fp"], "FN": mm["fn"]})
    comp = pd.DataFrame(filas)
    h1, h2 = st.columns([3, 2])
    with h1:
        st.dataframe(comp.round(3), use_container_width=True, hide_index=True)
        st.caption("VP/VN/FP/FN = verdaderos positivos, verdaderos negativos, falsos positivos y falsos negativos.")
    with h2:
        largo = comp.melt(id_vars="Método", value_vars=["Precisión", "Sensibilidad", "F1"], var_name="Métrica", value_name="Valor")
        fig_c = px.bar(largo, x="Método", y="Valor", color="Métrica", barmode="group", range_y=[0, 1])
        fig_c.update_xaxes(tickangle=-20)
        ajustar(fig_c, 320)
        st.plotly_chart(fig_c, use_container_width=True)
 
    # ---- 6. Coeficientes ----
    st.subheader("📋 Coeficientes del modelo")
    b_mod = modelo[0]
    coef = pd.DataFrame({"Variable": columnas, "Coeficiente (estandarizado)": b_mod[1:].round(4),
                         "Odds ratio (por +1 desv. est.)": np.exp(b_mod[1:]).round(3)})
    coef = coef.reindex(coef["Coeficiente (estandarizado)"].abs().sort_values(ascending=False).index)
    st.dataframe(coef, use_container_width=True, hide_index=True)
    st.caption("Odds ratio > 1 aumenta la probabilidad de «Sí»; < 1 la disminuye. Las variables se estandarizan para poder compararlas entre sí.")
 
    # ---- 7. CALCULADORA ----
    st.subheader("🧮 Calculadora de probabilidad")
    st.write(f"Captura las características de un lead y el modelo estimará la probabilidad de **{nombre_y}**.")
    entradas = {}
    cols_calc = st.columns(min(len(X_vars), 4))
    for i, v in enumerate(X_vars):
        with cols_calc[i % len(cols_calc)]:
            if v in categoricas:
                opciones = sorted(d[v].dropna().unique())
                entradas[v] = st.selectbox(v, opciones, key=f"calc_{v}")
            elif v == "Hora":
                entradas[v] = st.slider("Hora de origen", 0, 23, int(d["Hora"].median()), key="calc_hora")
            elif v == "Día de la semana (0=Lun)":
                dia = st.selectbox("Día de la semana", list(DIAS.values()), key="calc_dia")
                entradas[v] = [k_ for k_, val in DIAS.items() if val == dia][0]
            else:
                entradas[v] = st.number_input(v, value=float(d[v].median()), key=f"calc_{v}")
 
    fila = pd.DataFrame([entradas])
    X_union = codificar(pd.concat([X_raw, fila], ignore_index=True), categoricas)
    x_nuevo = X_union.reindex(columns=columnas, fill_value=0.0).iloc[[-1]].to_numpy(float)
    prob = float(proba(modelo, x_nuevo)[0])
 
    r1, r2_, r3 = st.columns([1, 1, 2])
    r1.metric("Probabilidad estimada", f"{prob:.1%}")
    r2_.metric("Clasificación", "✅ Sí" if prob >= umbral else "❌ No", help=f"Umbral actual: {umbral:.2f}")
    with r3:
        st.progress(min(max(prob, 0.0), 1.0))
        st.caption(f"Probabilidad base en la muestra: {n1 / len(y_all):.1%}. Método de ajuste: {metodo}.")
 